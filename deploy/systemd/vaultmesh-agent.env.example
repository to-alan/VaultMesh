# The control plane must be exposed through a trusted HTTPS reverse proxy.
VAULTMESH_SERVER_URL=https://backup.example.com

# Required only for first start. Remove it after enrollment succeeds.
VAULTMESH_ENROLLMENT_TOKEN=enroll_replace_me

# Optional executable overrides.
VAULTMESH_RESTIC_PATH=restic
VAULTMESH_MYSQLDUMP_PATH=mysqldump
VAULTMESH_PG_DUMP_PATH=pg_dump
VAULTMESH_DOCKER_PATH=docker

# Optional isolated restore destination. Every restore creates a new
# <command-id> directory and refuses to overwrite an existing target.
VAULTMESH_RESTORE_ROOT=/var/lib/vaultmesh-agent/restores

# Restic cache location. The systemd unit already pins this to
# /var/lib/vaultmesh-agent/cache (the default $HOME/.cache/restic is not
# writable under ProtectHome=read-only). Uncomment to move the cache to a
# larger disk; an entry here overrides the unit default. Without a writable
# cache directory Restic re-downloads repository metadata on every operation.
# RESTIC_CACHE_DIR=/var/lib/vaultmesh-agent/cache
