{
  "name": "vaultmesh-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:architecture && vue-tsc -b && vite build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "^4.1.11",
    "vue-tsc": "3.3.7"
  }
}
