# Generate with: openssl rand -base64 32
VAULTMESH_MASTER_KEY=

# Administrator console login. Generate the password with: openssl rand -hex 16
VAULTMESH_ADMIN_USERNAME=admin
VAULTMESH_ADMIN_PASSWORD=

# Set true when the browser reaches the API through HTTPS.
VAULTMESH_COOKIE_SECURE=false

# lax supports separate Web/API origins on the same site. For a trusted frontend
# on a completely different site, set none and also set COOKIE_SECURE=true.
VAULTMESH_COOKIE_SAME_SITE=lax

# Use a long random password. It is only used by the local PostgreSQL container.
POSTGRES_PASSWORD=

# API and Web are independent services. Defaults bind to all interfaces so a
# public VPS works without SSH tunnels; set 127.0.0.1 to restrict to loopback
# behind a reverse proxy or SSH tunnel.
VAULTMESH_BIND=0.0.0.0
VAULTMESH_API_PORT=8080
VAULTMESH_WEB_PORT=3000

# Prebuilt control/web image tag pulled from GHCR. Pin a release tag (e.g.
# v0.1.0) in production; "latest" follows the most recent release. The
# one-click installer writes this automatically on first install. To build
# locally from the cloned source instead, run:
#   docker compose up -d --build
VAULTMESH_IMAGE_TAG=v0.1.0

# URL used by the browser to reach the API. Production deployments should use HTTPS.
# When this is not an https:// URL (or VAULTMESH_HTTPS_ENABLED=true is not
# set), the control plane stays browsable but REFUSES backup and sync actions
# with 403 https_required until TLS is configured.
VAULTMESH_PUBLIC_API_URL=http://localhost:8080
# Set true only when TLS terminates elsewhere (e.g. the reverse proxy handles
# certificates but the upstream URL is still http).
# VAULTMESH_HTTPS_ENABLED=true

# Exact browser origins allowed to call the API, comma-separated and without trailing slashes.
VAULTMESH_ALLOWED_ORIGINS=http://localhost:3000

# Passkeys/WebAuthn. RP ID defaults to the hostname of the first allowed origin,
# and RP origins default to VAULTMESH_ALLOWED_ORIGINS. Set these explicitly when
# the browser uses more than one trusted origin. Production origins require HTTPS.
VAULTMESH_WEBAUTHN_RP_ID=localhost
VAULTMESH_WEBAUTHN_RP_NAME=VaultMesh
VAULTMESH_WEBAUTHN_RP_ORIGINS=http://localhost:3000

# Control-plane data retention in days. 0 disables pruning for that scope.
# Pending notification deliveries, running runs, and firing alert incidents are
# never pruned regardless of these values.
VAULTMESH_RETENTION_RUNS_DAYS=90
VAULTMESH_RETENTION_COMMANDS_DAYS=30
VAULTMESH_RETENTION_DELIVERIES_DAYS=90
VAULTMESH_RETENTION_INCIDENTS_DAYS=180
VAULTMESH_RETENTION_AUDIT_EVENTS_DAYS=365
